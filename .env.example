# ==============================================================================
# VectorCraft Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local configuration.
# For Coolify deployment, configure these variables in the Coolify Project Settings.
# NOTE: Never commit sensitive tokens or passwords to version control.

# Server listening port (default: 8767; dynamically set by Coolify/PaaS)
PORT=8767

# Network interface to bind to (0.0.0.0 binds all interfaces for container networking)
BIND=0.0.0.0

# Path to the compiled Trunk static web bundle
# Local development default: dist/web
# Docker container default: /app/dist/web
DIST_PATH=dist/web

# Logging verbosity level (options: error, warn, info, debug, trace)
RUST_LOG=info

# ==============================================================================
# Legal Information (R9: Impressum § 5 DDG & Datenschutz DSGVO)
# ==============================================================================
# Configure these variables in Coolify Environment Variables (do NOT hardcode in git).
LEGAL_COMPANY=Example GmbH
LEGAL_STREET=Musterstraße 1
LEGAL_CITY=12345 Musterstadt
LEGAL_REPRESENTATIVE=Max Mustermann
LEGAL_EMAIL=kontakt@example.com
LEGAL_PHONE=+49 123 456789
LEGAL_REGISTER_COURT=Amtsgericht Musterstadt
LEGAL_REGISTER_NUMBER=HRB 12345
LEGAL_VAT_ID=DE123456789
LEGAL_PRIVACY_DATE=Oktober 2026

# ==============================================================================
# Self-Hosted Web Analytics (R10: Umami)
# ==============================================================================
# Optional: Set both variables to enable cookieless self-hosted Umami analytics.
# Leave empty to disable analytics completely.
UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# ==============================================================================
# Ephemeral Collaboration & Resource Limits (R12)
# ==============================================================================
# Grace period in seconds before an empty room is purged from memory (default: 300)
ROOM_GRACE_SECONDS=300

# Maximum number of concurrent active rooms allowed in memory (default: 1000)
MAX_ROOMS=1000

# Maximum number of concurrent connected peers per room (default: 50)
MAX_CLIENTS_PER_ROOM=50

# Maximum allowed WebSocket message size in bytes (default: 10485760 = 10 MB)
MAX_MESSAGE_BYTES=10485760

# Maximum allowed room CRDT document size in bytes (default: 52428800 = 50 MB)
MAX_ROOM_BYTES=52428800

# ==============================================================================
# Resource Monitoring & Alerting (R14)
# ==============================================================================
# Protected metrics endpoint token (requires 'Authorization: Bearer <METRICS_TOKEN>')
# Leave empty to keep /metrics and /status disabled.
METRICS_TOKEN=example-metrics-bearer-token-placeholder

# Resource thresholds and cooldown
ALERT_MEM_PERCENT=80
ALERT_ROOMS_PERCENT=80
ALERT_COOLDOWN_MINUTES=60
ALERT_SEND_RECOVERY=true

# Optional Webhook Alert Destination (e.g. Slack/Discord/Mattermost incoming webhook)
# ALERT_WEBHOOK_URL=https://example.com/api/alerts-webhook

# Optional SMTP Email Alerts (Native container alerts via Coolify UI are recommended)
# ALERT_EMAIL_TO=alerts@example.com
# ALERT_EMAIL_FROM=noreply@example.com
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=smtp-user-placeholder
# SMTP_PASSWORD=smtp-password-placeholder
# SMTP_TLS=starttls

# ==============================================================================
# Self-Hosted DSGVO / GDPR-Compliant Font CDN Proxy
# ==============================================================================
# VectorCraft serves Google/OFL open-source fonts locally so client browsers
# never contact Google servers directly (LG München DSGVO-Urteil compliant).
# Missing fonts are fetched on demand by the backend server, cached permanently to disk,
# and served to the client with immutable HTTP cache headers.
FONTS_PROXY_ENABLED=true
FONTS_CACHE_DIR=/app/fonts_cache
FONTS_CDN_UPSTREAM=https://cdn.jsdelivr.net/gh/google/fonts@main

